# Font
font-family = JetBrainsMono Nerd Font
font-size = 12

# Barebones look — no decorations, no fluff
window-decoration = false
window-padding-x = 0
window-padding-y = 0
window-padding-balance = false

# Subtle terminal transparency; Hyprland supplies the background blur.
background-opacity = 0.90
background-blur = false

# Disable window title bar animations / vsync smoothing feel
window-vsync = false

# Cursor - simple block, no fancy blinking animation
cursor-style = block
cursor-style-blink = false

# No confirmation dialogs / minimal chrome
confirm-close-surface = false

# Shell integration off if you want pure minimal behavior (optional)
shell-integration = zsh
# Keep shell integration (cwd, title, etc.) but STOP zsh from overriding
# the cursor to a bar at the prompt. Without this, the prompt shows a bar
# cursor no matter what cursor-style says.
shell-integration-features = no-cursor

# Scrollback (keep reasonable, not unlimited)
scrollback-limit = 10000

# Mouse
mouse-hide-while-typing = true

# Muted blue-gray palette to match the desktop and Neovim.
theme = TokyoNight Storm

# Disable ligatures for a more "flat" monospace feel like Alacritty
font-feature = -liga
font-feature = -dlig

# =============================================================================
#  KEYBINDS — disabled Ghostty defaults so keystrokes pass through to tmux /
#  vim and other apps. `unbind` removes the binding and forwards the key to
#  the child process.
#
#  NOTE: Ghostty does NOT support inline (trailing) comments on a keybind
#  line, so reset/action notes are placed on their own lines above.
# =============================================================================

# ---- Tab / pane navigation (potentially conflicts with tmux ctrl+shift binds) --
keybind = ctrl+shift+arrow_left=unbind
keybind = ctrl+shift+arrow_right=unbind
keybind = ctrl+shift+tab=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+page_up=unbind
keybind = ctrl+page_down=unbind
keybind = ctrl+shift+page_up=unbind
keybind = ctrl+shift+page_down=unbind
keybind = ctrl+alt+arrow_up=unbind
keybind = ctrl+alt+arrow_down=unbind
keybind = ctrl+alt+arrow_left=unbind
keybind = ctrl+alt+arrow_right=unbind
keybind = super+ctrl+[=unbind
keybind = super+ctrl+]=unbind
keybind = super+ctrl+shift+arrow_up=unbind
keybind = super+ctrl+shift+arrow_down=unbind
keybind = super+ctrl+shift+arrow_left=unbind
keybind = super+ctrl+shift+arrow_right=unbind

# ---- Splits ----
keybind = ctrl+shift+o=unbind
keybind = ctrl+shift+e=unbind

# ---- Split zoom / fullscreen ----
keybind = ctrl+shift+enter=unbind
keybind = ctrl+enter=unbind

# ---- Tab switching on number row (conflicts with alt+number in apps/tmux) ----
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = alt+7=unbind
keybind = alt+8=unbind
keybind = alt+9=unbind
keybind = alt+digit_1=unbind
keybind = alt+digit_2=unbind
keybind = alt+digit_3=unbind
keybind = alt+digit_4=unbind
keybind = alt+digit_5=unbind
keybind = alt+digit_6=unbind
keybind = alt+digit_7=unbind
keybind = alt+digit_8=unbind
keybind = alt+digit_9=unbind

# ---- Other UI shortcuts you may want back in tmux/apps ----
keybind = ctrl+shift+f=unbind
keybind = ctrl+shift+i=unbind
keybind = ctrl+shift+p=unbind
keybind = ctrl+shift+a=unbind
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+n=unbind
keybind = ctrl+shift+w=unbind
keybind = ctrl+shift+j=unbind
keybind = ctrl+alt+shift+j=unbind
keybind = super+ctrl+shift+j=unbind

# ---- KEPT: copy/paste, font size, and config management (defaults, not unbound).
# Verify with: ghostty +list-keybinds
