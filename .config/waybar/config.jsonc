{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,
    "margin-top": 5,
    "margin-left": 8,
    "margin-right": 8,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "network", "pulseaudio", "backlight", "battery"],

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "tooltip-format": "{essid}"
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true,
        "active-only": false
    },

    "clock": {
        "format": " {:%I:%M %p}",
        "format-alt": " {:%Y-%m-%d}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "format-source": "󰍬",
        "format-source-muted": "󰍭",
        "tooltip-format": "Output: {volume}%",
        "tooltip-format-source": "Input: {volume}%",
        "on-click": "$HOME/.local/bin/osd output-mute",
        "on-click-middle": "$HOME/.local/bin/osd input-mute",
        "on-scroll-up": "$HOME/.local/bin/osd output-up",
        "on-scroll-down": "$HOME/.local/bin/osd output-down",
        "scroll-step": 5
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "scroll-step": 5,
        "on-scroll-up": "$HOME/.local/bin/osd brightness-up",
        "on-scroll-down": "$HOME/.local/bin/osd brightness-down",
        "tooltip-format": "Brightness: {percent}%"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}",
        "tooltip-format": "Battery: {capacity}%",
        "format-charging": "󰂄",
        "format-plugged": "󰂄",
        "format-full": "󰁹",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    }
}
