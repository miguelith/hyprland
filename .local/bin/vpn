#!/usr/bin/env bash
set -euo pipefail

usage() { echo "Usage: vpn {status|off|warp|tailscale}" >&2; exit 2; }
[[ $# == 1 ]] || usage

# --- state detection: exactly one of off / warp / tailscale ---

warp_up() {
  # service active + daemon not disconnected counts as warp
  # (covers the "Connecting" phase right after warp-cli connect)
  systemctl is-active --quiet warp-svc.service || return 1
  warp-cli status 2>/dev/null | grep -q 'Disconnected' && return 1
  return 0
}

tailscale_up() {
  systemctl is-active --quiet tailscaled.service
}

current_state() {
  if warp_up; then
    echo "warp"
  elif tailscale_up; then
    echo "tailscale"
  else
    echo "off"
  fi
}

stop_tailscale() {
  if tailscale_up; then
    sudo tailscale down
    sudo systemctl stop tailscaled.service
  fi
}

stop_warp() {
  if systemctl is-active --quiet warp-svc.service; then
    if warp_up; then warp-cli disconnect; fi
    sudo systemctl stop warp-svc.service
  fi
}

show_status() {
  local state message
  state=$(current_state)
  case "$state" in
    warp)      message="VPN: warp (connected)" ;;
    tailscale) message="VPN: tailscale (connected)" ;;
    off)       message="VPN: off" ;;
  esac
  printf '%s\n' "$message"
  notify_vpn "$message"
}

notify_vpn() {
  dunstify --app-name=Hyprland --urgency=normal --timeout=10000 --stack-tag vpn-status \
    'VPN' "$1" >/dev/null
}

signal_waybar() {
  pkill -RTMIN+11 waybar 2>/dev/null || true
}

case "$1" in
  status) show_status ;;
  off)
    if [ "$(current_state)" = off ]; then
      notify_vpn 'VPN: off'
      echo 'VPN: off'
      signal_waybar
      exit 0
    fi
    notify_vpn 'VPN: stopping both...'
    stop_warp
    stop_tailscale
    echo 'VPN: off'
    notify_vpn 'VPN: off'
    signal_waybar
    ;;
  warp)
    if [ "$(current_state)" = warp ]; then
      notify_vpn 'VPN: warp (connected)'
      echo 'VPN: warp'
      signal_waybar
      exit 0
    fi
    notify_vpn 'VPN: switching to warp...'
    stop_tailscale
    sudo systemctl start warp-svc.service
    # warp-svc opens its IPC socket asynchronously; wait for it before connecting
    for _ in $(seq 1 20); do
      warp-cli status >/dev/null 2>&1 && break
      sleep 0.5
    done
    warp-cli connect
    echo 'VPN: warp'
    notify_vpn 'VPN: warp (connected)'
    signal_waybar
    ;;
  tailscale)
    if [ "$(current_state)" = tailscale ]; then
      notify_vpn 'VPN: tailscale (connected)'
      echo 'VPN: tailscale'
      signal_waybar
      exit 0
    fi
    notify_vpn 'VPN: switching to tailscale...'
    stop_warp
    sudo systemctl start tailscaled.service
    sudo tailscale up
    echo 'VPN: tailscale'
    notify_vpn 'VPN: tailscale (connected)'
    signal_waybar
    ;;
  waybar)
    state=$(current_state)
    case "$state" in
      warp)      text="warp"      ;;
      tailscale) text="tailscale" ;;
      *)         text="off"       ;;
    esac
    tooltip="VPN: $text"
    printf '{"text": "%s", "tooltip": "%s", "class": "%s"}\n' "$text" "$tooltip" "$text"
    ;;
  *) usage ;;
esac
